#!/bin/bash
# What runs when FRITS.app is double-clicked.
# If FRITS has its window ("frits ui"), start it. Until then, open a Terminal window.
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
LOG="$HOME/Library/Logs/FRITS.log"
mkdir -p "$(dirname "$LOG")"

# The start files are the last ones in the zip. If they are missing, unpacking stopped early,
# usually because the disk was full. Say so instead of quietly closing.
if [ ! -f "$RES/frits-launch.sh" ]; then
  echo "$(date): FRITS.app is incomplete, $RES/frits-launch.sh is missing" >>"$LOG"
  osascript -e 'display alert "FRITS ist nicht vollständig entpackt" message "Beim Entpacken hat wahrscheinlich der Speicherplatz nicht gereicht. Bitte etwa 2,5 GB frei machen, diesen FRITS-Ordner löschen und FRITS-macOS.zip noch einmal entpacken." as critical' >/dev/null 2>&1
  exit 1
fi

# Lets the "FRITS ist aus" page offer a "FRITS wieder starten" button (frits://start).
export FRITS_APP=1
# When the double-click happened, so the log can say how long the start took.
export FRITS_START="$(date +%s)"
echo "$(date '+%Y-%m-%d %H:%M:%S') FRITS.app gestartet" >>"$LOG"

# Something to look at right away: the loading page waits for FRITS and then becomes FRITS.
# Not when FRITS already runs (then it just shows itself again).
if [ -f "$RES/laden/index.html" ] \
   && ! curl -fsS --max-time 1 "http://127.0.0.1:8765/health" 2>/dev/null | grep -q "^FRITS"; then
  open "$RES/laden/index.html" && export FRITS_LADESEITE=1
fi

"$RES/frits-launch.sh" ui >>"$LOG" 2>&1
status=$?
# Python couldn't start FRITS at all (seconds after the double-click): open a Terminal window
# that shows what is wrong, instead of quietly closing.
if [ "$status" -ne 0 ] && [ $(( $(date +%s) - FRITS_START )) -lt 30 ]; then
  echo "$(date '+%Y-%m-%d %H:%M:%S') FRITS ui endete mit $status" >>"$LOG"
  exec open -a Terminal "$RES/frits-terminal.command"
fi
exit "$status"
